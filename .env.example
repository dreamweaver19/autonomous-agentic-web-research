# ─────────────────────────────────────────────
# Autonomous Agentic Web Research System
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────
DATABASE_URL=sqlite:///./research.db
# For PostgreSQL: postgresql://user:password@localhost:5432/research_db

# ── Ollama (local LLM) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Set to false to skip Ollama and use deterministic fallback
OLLAMA_ENABLED=true

# ── Optional Cloud LLM (OpenAI-compatible) ────
CLOUD_LLM_ENABLED=false
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_API_KEY=your_api_key_here
CLOUD_LLM_MODEL=gpt-4o-mini

# ── Search Provider ───────────────────────────
# Options: serper, serpapi, duckduckgo_html, none
SEARCH_PROVIDER=duckduckgo_html
SERPER_API_KEY=
SERPAPI_KEY=

# ── Crawl Defaults ────────────────────────────
DEFAULT_MAX_PAGES=20
DEFAULT_CRAWL_DEPTH=2
DEFAULT_REQUEST_TIMEOUT=15
DEFAULT_MAX_RESPONSE_SIZE_KB=2048
DEFAULT_RATE_LIMIT_DELAY=1.5

# ── Security ──────────────────────────────────
# Comma-separated domain blocklist (added to built-in SSRF blocklist)
EXTRA_BLOCKED_DOMAINS=

# ── Playwright (optional JS rendering) ────────
PLAYWRIGHT_ENABLED=false
